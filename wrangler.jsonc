{
  // Cloudflare Workers: serve o site estático e a rota /api/apuracao
  "name": "eleicoes-2026",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
