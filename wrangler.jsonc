{
  // Cloudflare Workers: serve o site estático e a rota /api/apuracao
  "name": "eleicoes-2026",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "DADOS", "id": "8827c974ae6c4dcd93478f09adfa3f7c" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
