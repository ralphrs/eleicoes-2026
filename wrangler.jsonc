{
  // Cloudflare Workers: serve o site estático e a rota /api/apuracao
  "name": "eleicoes-2026",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "eleicoes-2026", "database_id": "00b40ce5-dd65-4a40-814c-4244e910877a" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
